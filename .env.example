# скопируй в .env и заполни
ADMIN_TOKEN=поменяй-на-длинную-случайную-строку
SHORTCUT_ICLOUD_URL=
TZ=Europe/Moscow

# Письма с кодом на смену пароля. Шлём через RuSender по HTTP (порт 443):
# хостинг режет почтовые порты, а 443 открыт всегда. Пусто = писем нет,
# код уходит в телеграм, как раньше.
RUSENDER_KEY=
RUSENDER_SEND_KEY=
MAIL_FROM=vita@vitadots.ru
MAIL_FROM_NAME=Vita
# запасной путь — обычный SMTP (нужен сервис с портом 2525, 465 и 587 закрыты)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
