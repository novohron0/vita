# скопируй в .env и заполни
ADMIN_TOKEN=поменяй-на-длинную-случайную-строку
SHORTCUT_ICLOUD_URL=
TZ=Europe/Moscow

# Письма с кодом на смену пароля (DashaMail: 2000 писем в месяц бесплатно).
# Хостинг режет 25/465/587 — порт только 2525. Пусто = писем нет, код идёт в телеграм.
# Имя хоста именно smtps.dashasender.ru: на smtp.dashamail.ru сертификат чужой.
SMTP_HOST=smtps.dashasender.ru
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=vita@vitadots.ru
SMTP_FROM_NAME=Vita
