# скопируй в .env и заполни
ADMIN_TOKEN=поменяй-на-длинную-случайную-строку
SHORTCUT_ICLOUD_URL=
TZ=Europe/Moscow

# Бот @vitadots_bot: вход на сайт одной кнопкой «Старт» и отзывы в чат.
# Вебхук ставится сам при старте на PUBLIC_URL/tg/hook (TG_WEBHOOK=0 — не ставить).
TG_BOT_TOKEN=
TG_BOT_NAME=vitadots_bot
PUBLIC_URL=https://vitadots.ru
# чат для отзывов — ставит scripts/reviews-chat.sh, руками не нужно
TG_REVIEWS_CHAT=

# Письма с кодом на смену пароля. Шлём через RuSender по HTTP (порт 443):
# хостинг режет почтовые порты, а 443 открыт всегда. Пусто = писем нет,
# код уходит в телеграм, как раньше.
RUSENDER_KEY=
RUSENDER_SEND_KEY=
MAIL_FROM=vita@vitadots.ru
MAIL_FROM_NAME=Vita
# запасной путь — обычный SMTP (нужен сервис с портом 2525, 465 и 587 закрыты)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
