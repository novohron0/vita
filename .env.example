# скопируй в .env и заполни
ADMIN_TOKEN=поменяй-на-длинную-случайную-строку
SHORTCUT_ICLOUD_URL=
TZ=Europe/Moscow

# Письма с кодом на смену пароля (SendPulse: 12 000 писем в месяц бесплатно).
# Хостинг режет 25/465/587 — порт только 2525. Пусто = писем нет, код идёт в телеграм.
SMTP_HOST=smtp-pulse.com
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=vita@vitadots.ru
SMTP_FROM_NAME=Vita
